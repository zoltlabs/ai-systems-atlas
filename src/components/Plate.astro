---
/* Plate anatomy (DESIGN.md §4): title row → definition → diagram shell → step-by-step
   walkthrough → meta grid → Further reading → Related. */
import Diagram from './Diagram.astro';
import { DIAGRAMS } from '../data/diagrams.js';
import type { Plate } from '../lib/seo';
import { plateUrl } from '../lib/seo';
import { resolveRefs } from '../data/references.js';

interface Props { colId: string; p: Plate; routed?: boolean; heading?: 'h1' | 'h3'; }
const { colId, p, routed = false, heading = 'h3' } = Astro.props;
const route = plateUrl(colId, p.slug);
const D = DIAGRAMS as Record<string, any>;
const CUSTOM_HEIGHTS: Record<string, number> = { map: 470, regression: 340, taxonomy: 430, mismatch: 320, anatomy: 500, budget: 420 };
const customData = p.custom === 'mismatch' ? { lucky: D.mismatchLucky, unlucky: D.mismatchUnlucky } : undefined;
const modes = p.modes?.map(m => ({ id: m.id, label: m.label, cls: m.cls, def: D[m.dg] }));
const Heading = heading;
const refs = resolveRefs(p.refs);
/* Server-rendered walkthrough: the same step captions the engine animates, as real HTML so
   they are indexable, screen-reader reachable and a no-JS fallback. Custom renderers have no
   steps and get none (their text lives in the renderer; we don't invent any). */
const capsOf = (def: any): string[] => (def?.steps ?? []).map((s: any) => s.cap).filter((c: any) => typeof c === 'string' && c.trim());
const walk = p.custom ? [] : modes
  ? modes.map(m => ({ id: m.id, label: m.label as string | undefined, cls: m.cls, caps: capsOf(m.def) })).filter(m => m.caps.length)
  : [{ id: 'main', label: undefined, cls: undefined, caps: capsOf(D[p.dg!]) }].filter(m => m.caps.length);
const walkCount = walk.reduce((n, m) => n + m.caps.length, 0);
---
<article class="plate" id={`plate-${p.slug}`}>
  <div class="plate-head">
    <div>
      <Heading class="plate-title"><span class="code-badge">{p.code}</span><span>{p.title}</span></Heading>
    </div>
    <a class="plate-link" href={route} title="Deep link to this plate">{route}</a>
  </div>
  <p class="plate-def" set:html={p.def} />
  {p.custom
    ? <Diagram custom={p.custom} data={customData} minHeight={CUSTOM_HEIGHTS[p.custom]} />
    : modes
      ? <Diagram modes={modes} routed={routed} walkthrough={walk.length > 0} />
      : <Diagram def={D[p.dg!]} walkthrough={walk.length > 0} />}
  {walk.length > 0 && (
    <details class="plate-steps">
      <summary>Step-by-step walkthrough<span class="ps-count">{walk.length > 1 ? `${walk.length} variants · ${walkCount} steps` : `${walkCount} steps`}</span></summary>
      <div class={walk.length > 1 ? 'ps-body ps-modes' : 'ps-body'}>
        {walk.map(m => (
          <section class={`ps-mode${m.cls ? ' ' + m.cls : ''}`} data-walk={m.id}>
            {/* mode labels are list captions, not page sections — no heading level */}
            {m.label && <p class="ps-label" id={`walk-${p.slug}-${m.id}`}>{m.label}</p>}
            <ol aria-labelledby={m.label ? `walk-${p.slug}-${m.id}` : undefined}>{m.caps.map(c => <li set:html={c} />)}</ol>
          </section>
        ))}
      </div>
    </details>
  )}
  <div class="plate-meta">
    <div class="meta-cell insight"><div class="mlabel">Key insight</div><p set:html={p.insight} /></div>
    <div class="meta-cell failure"><div class="mlabel">Failure mode</div><p set:html={p.failure} /></div>
  </div>
  {refs.length > 0 && (
    <div class="plate-refs">
      <div class="mlabel">Further reading</div>
      <ul>
        {refs.map(r => (
          <li>
            <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
            <span class="ref-where">{r.where}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
  {p.related && p.related.length > 0 && (
    <div class="plate-related"><span class="rlabel">Related</span>{p.related.map(([t, r]) => <a class="chip" href={r}>{t}</a>)}</div>
  )}
</article>
