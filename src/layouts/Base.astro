---
import '../styles/fonts.css';
import '../styles/atlas.css';
import { SITE, LINKS } from '../site';
import { collections, colOrder, absolute, ogImage } from '../lib/seo';
import { SEARCH_INDEX, DIAGRAM_COUNT, PLATE_COUNT } from '../data/collections.js';
/* the two latin faces that render everything above the fold — fetched in parallel with the
   stylesheet instead of after it */
import jakartaLatin from '../fonts/plus-jakarta-sans-latin-wght-normal.woff2?url';
import bricolageLatin from '../fonts/bricolage-grotesque-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;              // canonical path, e.g. "/harnesses/react"
  activeCol?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  image?: string;            // absolute or root-relative OG image
}
const { title, description, path, activeCol = '', ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = absolute(path);
const image = absolute(Astro.props.image || ogImage(path));
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const searchJson = JSON.stringify(SEARCH_INDEX).replace(/</g, '\\u003c');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F6F4" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121316" />
  <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title} — diagram card`} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}


  {ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}

  <script is:inline>
    /* legacy hash routes (#/harnesses/react) → real URLs, before first paint */
    (function () { var m = /^#\/([^?]*)(\?.*)?$/.exec(location.hash); if (m) { location.replace('/' + m[1].replace(/\/+$/, '') + (m[2] || '')); } })();
    /* stamp a stored theme choice before first paint; absent = system (see src/scripts/theme.js) */
    (function () { try { var t = localStorage.getItem('atlas-theme'); if (t === 'light' || t === 'dark') { var r = document.documentElement; r.setAttribute('data-theme', t); r.setAttribute('data-theme-pref', t); } } catch (e) {} })();
  </script>
</head>
<body>
  <header class="nav"><div class="wrap nav-in">
    <a class="brand" href="/" aria-label="AI Systems Atlas home">
      <svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="10" width="6" height="6" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M7 4h4.5A1.5 1.5 0 0 1 13 5.5V10M10 13H5.5A1.5 1.5 0 0 1 4 11.5V7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      AI Systems Atlas</a>
    <nav class="nav-links" aria-label="Collections">
      {colOrder.map(c => <a href={`/${c}`} aria-current={activeCol === c ? 'page' : undefined}>{collections[c].short}</a>)}
    </nav>
    <button class="nav-theme" type="button" data-theme-btn aria-label="Theme: system. Switch to light." title="Theme: system — switch to light">
      <svg data-icon="system" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 2.4A5.6 5.6 0 0 1 8 13.6z" fill="currentColor"/></svg>
      <svg data-icon="light" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1v1.8M8 13.2V15M15 8h-1.8M2.8 8H1M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3M12.9 12.9l-1.3-1.3M4.4 4.4L3.1 3.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg data-icon="dark" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.4 9.7A5.9 5.9 0 0 1 6.3 2.6a5.9 5.9 0 1 0 7.1 7.1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    </button>
    <button class="nav-search" type="button" data-search-btn aria-label="Search the atlas"><svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><circle cx="6" cy="6" r="4.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9.4 9.4L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span class="nslabel">Search</span><kbd>⌘K</kbd></button>
  </div></header>

  <slot />

  <footer><div class="wrap foot-in">
    <span style="font-weight:700;color:var(--ink2)">AI Systems Atlas</span>
    <span>An interactive reference for how modern AI agents are built, secured, evaluated and fed context.</span>
    <span class="foot-links">
      <a href={SITE.repo} rel="noopener">Source on GitHub</a>
      <a href={LINKS.newsletter.href} rel="noopener">{LINKS.newsletter.name}</a>
      <a href={LINKS.lab.href} rel="noopener">Built by {LINKS.lab.name}</a>
    </span>
    <span class="mono">DIAGRAMS: {DIAGRAM_COUNT} · PLATES: {PLATE_COUNT}</span>
  </div></footer>

  <div class="pal-scrim" id="palScrim"></div>
  <div class="pal" id="pal" role="dialog" aria-modal="true" aria-label="Search the atlas">
    <input id="palInput" type="text" placeholder="Search concepts… (prompt injection, critic, memory)" autocomplete="off" spellcheck="false">
    <div class="pal-list" id="palList" role="listbox"></div>
  </div>
  <script type="application/json" id="searchIndex" set:html={searchJson} />
  <script>import '../scripts/atlas.js';</script>
</body>
</html>
